menu "Temperature gateway configuration"

config GATEWAY_WIFI_SSID
    string "Wi-Fi station SSID"
    default ""
    help
        Existing 2.4 GHz Wi-Fi network to join. Leave empty to start the
        fallback access point immediately. This value can also be changed
        from the gateway Settings page and is then stored in NVS.

config GATEWAY_WIFI_PASSWORD
    string "Wi-Fi station password"
    default ""

config GATEWAY_WIFI_DEFAULTS_REVISION
    int "Compiled Wi-Fi defaults revision"
    default 2
    range 1 255
    help
        Increment this when the compiled station credentials are deliberately
        changed. The first boot for a new revision replaces the stored station
        credentials with the compiled defaults, then normal Settings page
        changes are preserved in NVS.

config GATEWAY_AP_SSID
    string "Fallback access point SSID"
    default "Temperature-Gateway"

config GATEWAY_AP_PASSWORD
    string "Fallback access point password"
    default "temperature"
    help
        Must contain 8 to 63 characters.

config GATEWAY_STA_CONNECT_TIMEOUT_SECONDS
    int "Seconds before enabling the fallback AP"
    range 5 120
    default 20

config GATEWAY_HISTORY_SAMPLES
    int "Samples retained in ESP32 RAM"
    range 60 3600
    default 900
    help
        Samples arrive once per second, so 900 samples retain about 15
        minutes. Larger values use more internal RAM.

endmenu
